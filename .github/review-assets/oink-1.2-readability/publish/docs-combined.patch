diff --git a/tests/browser/filetree-comments.spec.mjs b/tests/browser/filetree-comments.spec.mjs
new file mode 100644
index 0000000..67895b9
--- /dev/null
+++ b/tests/browser/filetree-comments.spec.mjs
@@ -0,0 +1,123 @@
+import { expect, test } from '@playwright/test';
+
+test.use({ hasTouch: true });
+
+async function expectReadableComments(tree, count, columns) {
+  const measured = await tree.evaluate((element) => {
+    const rows = [...element.querySelectorAll('.td-filetree__row')]
+      .filter((row) => row.getClientRects().length);
+    return {
+      rows: rows.map((row) => {
+        const box = row.getBoundingClientRect();
+        const icon = row.querySelector('.td-filetree__icon').getBoundingClientRect();
+        return {
+          top: box.top,
+          bottom: box.bottom,
+          height: box.height,
+          minHeight: parseFloat(getComputedStyle(row).minBlockSize),
+          guideHeight: getComputedStyle(row).backgroundSize,
+          iconCentre: (icon.top + icon.bottom) / 2,
+        };
+      }),
+      comments: [...element.querySelectorAll('.td-filetree__comment-text')]
+        .filter((node) => node.getClientRects().length)
+        .map((node) => {
+          const box = node.getBoundingClientRect();
+          const row = node.closest('.td-filetree__row').getBoundingClientRect();
+          const cell = node.parentElement.getBoundingClientRect();
+          const range = document.createRange();
+          range.selectNodeContents(node);
+          const fragments = [...range.getClientRects()];
+          return {
+            text: node.textContent,
+            clipped: node.scrollWidth > node.clientWidth + 1,
+            contained: fragments.every((line) =>
+              line.left >= box.left - 1 && line.right <= box.right + 1 &&
+              line.top >= row.top - 1 && line.bottom <= row.bottom + 1),
+            column: cell.left,
+            cellTop: cell.top,
+            cellBottom: cell.bottom,
+            rowTop: row.top,
+            rowBottom: row.bottom,
+          };
+        }),
+    };
+  });
+  expect(measured.comments).toHaveLength(count);
+  for (const comment of measured.comments) {
+    expect(comment.clipped, comment.text).toBe(false);
+    expect(comment.contained, comment.text).toBe(true);
+    if (columns) {
+      expect(Math.abs(comment.cellTop - comment.rowTop)).toBeLessThanOrEqual(1);
+      expect(Math.abs(comment.cellBottom - comment.rowBottom)).toBeLessThanOrEqual(1);
+    }
+  }
+  if (columns) {
+    const starts = measured.comments.map(({ column }) => Math.round(column));
+    expect(new Set(starts).size).toBe(1);
+  }
+  measured.rows.forEach((row, index) => {
+    expect(row.height).toBeGreaterThanOrEqual(row.minHeight - 1);
+    if (index) expect(row.top).toBeGreaterThanOrEqual(measured.rows[index - 1].bottom - 1);
+    // The indent guides cover the whole variable-height row. Name icons stay
+    // centred beside the description in the two-column layout.
+    expect(row.guideHeight).toMatch(/100%$/);
+    if (columns) expect(Math.abs(row.iconCentre - (row.top + row.bottom) / 2)).toBeLessThanOrEqual(1);
+  });
+}
+
+for (const language of ['', '/zh']) {
+  for (const width of [1440, 768, 390]) {
+    for (const mode of ['light', 'dark']) {
+      test(`${language || 'en'} comments stay readable at ${width}px in ${mode}`, async ({ page }) => {
+        await page.addInitScript((color) => {
+          localStorage.setItem('td-preset', 'slate');
+          localStorage.setItem('td-color-theme', color);
+        }, mode);
+        await page.setViewportSize({ width, height: 1000 });
+        await page.goto(`${language}/tests/filetree-comments/`, { waitUntil: 'domcontentloaded' });
+        await page.evaluate(() => document.fonts.ready);
+        await expect(page.locator('html')).toHaveAttribute('data-bs-theme', mode);
+        const trees = page.locator('.td-content .td-filetree');
+        await expect(trees).toHaveCount(2);
+        const tree = trees.first();
+        await expectReadableComments(tree, 3, width >= 576);
+        await expectReadableComments(trees.nth(1), 1, width >= 576);
+        if (width >= 576) {
+          const divider = tree.getByRole('separator');
+          await divider.focus();
+          for (const [key, value] of [['Home', '50'], ['End', '70']]) {
+            await divider.press(key);
+            await expect(divider).toHaveAttribute('aria-valuenow', value);
+            await expectReadableComments(tree, 3, true);
+          }
+        } else {
+          await expect(tree.getByRole('separator')).toBeHidden();
+        }
+        const folder = tree.locator('details:has(> summary .td-filetree__name[title="data/"])');
+        await folder.locator('> summary').press('Enter');
+        await expect(tree.locator('.td-filetree__comment-text').first()).toBeHidden();
+        await folder.locator('> summary').tap({ position: { x: 24, y: 12 } });
+        await expectReadableComments(tree, 3, width >= 576);
+        expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth + 1)).toBe(true);
+      });
+    }
+  }
+
+  test(`${language || 'en'} comments print fully and remain readable without JavaScript`, async ({ browser, baseURL }) => {
+    const context = await browser.newContext({ baseURL, javaScriptEnabled: false, viewport: { width: 768, height: 1000 } });
+    const page = await context.newPage();
+    await page.goto(`${language}/tests/filetree-comments/`, { waitUntil: 'domcontentloaded' });
+    const trees = page.locator('.td-content .td-filetree');
+    await expectReadableComments(trees.first(), 3, true);
+    await expectReadableComments(trees.nth(1), 1, true);
+    await page.goto(`${language}/_print/tests/filetree-comments/`, { waitUntil: 'domcontentloaded' });
+    await page.emulateMedia({ media: 'print' });
+    const printed = page.locator('.td-filetree--static');
+    await expect(printed).toHaveCount(2);
+    await expect(printed.locator('details, [role="separator"]')).toHaveCount(0);
+    await expectReadableComments(printed.first(), 3, true);
+    await expectReadableComments(printed.nth(1), 1, true);
+    await context.close();
+  });
+}
diff --git a/tests/browser/markmap-theme.spec.mjs b/tests/browser/markmap-theme.spec.mjs
new file mode 100644
index 0000000..0b8d725
--- /dev/null
+++ b/tests/browser/markmap-theme.spec.mjs
@@ -0,0 +1,109 @@
+import { expect, test } from '@playwright/test';
+
+const diagramSelector = '.td-content > .markmap > svg.markmap';
+
+function contrast(first, second) {
+  const luminance = (rgb) => {
+    const values = rgb.match(/[\d.]+/g).slice(0, 3).map(Number).map((value) => {
+      const channel = value / 255;
+      return channel <= 0.04045 ? channel / 12.92 : ((channel + 0.055) / 1.055) ** 2.4;
+    });
+    return values.reduce((total, value, index) => total + value * [0.2126, 0.7152, 0.0722][index], 0);
+  };
+  const values = [luminance(first), luminance(second)].sort((a, b) => a - b);
+  return (values[1] + 0.05) / (values[0] + 0.05);
+}
+
+async function nodeColors(diagram) {
+  return diagram.locator('.markmap-foreign').evaluateAll((nodes) => ({
+    ink: [...new Set(nodes.map((node) => getComputedStyle(node).color))],
+    body: getComputedStyle(document.body).color,
+    canvas: getComputedStyle(document.body).backgroundColor,
+  }));
+}
+
+async function expectReadable(diagram, followsBody = true) {
+  await expect(diagram.locator('.markmap-node')).toHaveCount(7);
+  if (followsBody) {
+    await expect.poll(async () => {
+      const colors = await nodeColors(diagram);
+      return colors.ink.every((ink) => ink === colors.body);
+    }).toBe(true);
+  }
+  const colors = await nodeColors(diagram);
+  for (const ink of colors.ink) expect(contrast(ink, colors.canvas)).toBeGreaterThanOrEqual(4.5);
+}
+
+async function appearance(page) {
+  // The footer entry stays actionable after the SVG screenshot scrolls the
+  // autohiding navbar away. Exercise the same native Appearance controls.
+  await page.locator('[aria-controls="td-appearance-footer"]').click();
+  const panel = page.locator('dialog.td-appearance__panel[open]');
+  await expect(panel).toBeVisible();
+  return panel;
+}
+
+for (const locale of ['', '/zh']) {
+  for (const width of [390, 1440]) {
+    test(`Markmap plain labels track appearance, ${locale || 'en'} ${width}`, async ({ page }, info) => {
+      const errors = [];
+      page.on('pageerror', (error) => errors.push(error.message));
+      await page.route('https://giscus.app/**', (route) => route.abort());
+      await page.setViewportSize({ width, height: 1000 });
+      await page.addInitScript(() => {
+        if (!sessionStorage.getItem('markmap-seeded')) {
+          localStorage.setItem('td-preset', 'slate');
+          localStorage.setItem('td-color-theme', 'dark');
+          sessionStorage.setItem('markmap-seeded', 'yes');
+        }
+      });
+      await page.goto(`${locale}/tests/markmap-theme/`);
+      const diagram = page.locator(diagramSelector);
+      await expectReadable(diagram);
+      await diagram.screenshot({ path: info.outputPath('slate-dark.png') });
+
+      // Use the real controls; CSS must update without recreating the SVG.
+      await diagram.evaluate((svg) => { svg.dataset.markmapTestIdentity = 'original'; });
+      for (const preset of ['paper', 'ink', 'terminal', 'slate']) {
+        const panel = await appearance(page);
+        await panel.locator(`[data-td-preset-value="${preset}"]`).check();
+        for (const mode of ['light', 'dark']) {
+          await panel.locator(`[data-bs-theme-value="${mode}"]`).check();
+          await expect(page.locator('html')).toHaveAttribute('data-td-preset', preset);
+          await expect(page.locator('html')).toHaveAttribute('data-bs-theme', mode);
+          await expectReadable(diagram);
+        }
+        await page.keyboard.press('Escape');
+      }
+      await expect(diagram).toHaveAttribute('data-markmap-test-identity', 'original');
+      await page.reload();
+      await expect(page.locator('html')).toHaveAttribute('data-bs-theme', 'dark');
+      await expectReadable(diagram);
+
+      const server = diagram.locator('.markmap-node').filter({ hasText: /^server$/ });
+      await server.locator('circle').click();
+      await expect(diagram.locator('.markmap-node')).toHaveCount(4);
+      await server.locator('circle').click();
+      await expectReadable(diagram);
+      const transform = await diagram.locator(':scope > g').getAttribute('transform');
+      await diagram.hover();
+      await page.mouse.wheel(0, -120);
+      await expect.poll(() => diagram.locator(':scope > g').getAttribute('transform')).not.toBe(transform);
+
+      // Dark-mode preferences must not turn a white print canvas into white-on-white text.
+      await page.emulateMedia({ media: 'print' });
+      await expectReadable(diagram, false);
+      await page.goto(`${locale}/_print/tests/markmap-theme/`);
+      await expectReadable(page.locator(diagramSelector), false);
+      await page.emulateMedia({ media: 'screen' });
+
+      // A normal site stylesheet can still customize the public vendor token.
+      await page.goto(`${locale}/tests/markmap-theme/`);
+      const siteStyle = await page.addStyleTag({ content: '.td-content .markmap { --markmap-text-color: rgb(12, 123, 210); }' });
+      await expect(page.locator(diagramSelector).locator('.markmap-foreign').first()).toHaveCSS('color', 'rgb(12, 123, 210)');
+      await siteStyle.evaluate((element) => element.remove());
+      await expectReadable(page.locator(diagramSelector));
+      expect(errors).toEqual([]);
+    });
+  }
+}
diff --git a/tests/browser/rail-footer.spec.mjs b/tests/browser/rail-footer.spec.mjs
new file mode 100644
index 0000000..d6c45c9
--- /dev/null
+++ b/tests/browser/rail-footer.spec.mjs
@@ -0,0 +1,164 @@
+import { expect, test } from '@playwright/test';
+
+const panelSelector = '.td-shell-toc__panel';
+const asideSelector = `${panelSelector} > [data-td-shell-aside]`;
+const tagSelector = '[data-td-taxonomy="tags"] .td-shell-tag';
+
+async function open(page, path = '/docs/rail-footer/fixed/', mode = 'light') {
+  await page.setViewportSize({ width: 1440, height: 1000 });
+  await page.addInitScript((mode) => {
+    localStorage.clear();
+    localStorage.setItem('td-color-theme', mode);
+    localStorage.setItem('td-preset', 'slate');
+  }, mode);
+  await page.goto(path, { waitUntil: 'networkidle' });
+  await page.evaluate(() => document.fonts.ready);
+  await expect(page.locator('html')).toHaveAttribute('data-bs-theme', mode);
+  await expect(page.locator('html')).toHaveAttribute('data-td-shell-initialized', '');
+}
+
+async function atBottom(page) {
+  // Use real wheel input over the article. A disclosure resize can change
+  // the document height after a wheel event, so keep scrolling until settled.
+  await page.mouse.move(700, 200);
+  await expect(async () => {
+    await page.mouse.wheel(0, 20000);
+    await expect.poll(() => page.evaluate(() =>
+      Math.abs(scrollY + innerHeight - document.documentElement.scrollHeight),
+    ), { timeout: 1000 }).toBeLessThanOrEqual(2);
+  }).toPass({ timeout: 5000 });
+}
+
+async function geometry(page) {
+  return page.evaluate(({ panelSelector, asideSelector, tagSelector }) => {
+    const panel = document.querySelector(panelSelector);
+    const aside = document.querySelector(asideSelector);
+    const footer = document.querySelector('[data-td-shell-footer]');
+    const tags = panel.querySelectorAll(tagSelector);
+    const tag = tags[tags.length - 1];
+    const bounds = (element) => {
+      const r = element.getBoundingClientRect();
+      return { x: r.x, y: r.y, width: r.width, height: r.height, bottom: r.bottom };
+    };
+    const r = tag?.getBoundingClientRect();
+    const point = r && document.elementFromPoint(r.x + r.width / 2, r.y + r.height / 2);
+    return {
+      panel: bounds(panel),
+      footer: footer && bounds(footer),
+      aside: aside && {
+        ...bounds(aside), scrollHeight: aside.scrollHeight,
+        clientHeight: aside.clientHeight, scrollTop: aside.scrollTop,
+      },
+      tag: tag && { ...bounds(tag), hit: tag === point || tag.contains(point) },
+      position: getComputedStyle(panel).position,
+      inset: getComputedStyle(panel).insetBlockEnd,
+    };
+  }, { panelSelector, asideSelector, tagSelector });
+}
+
+async function expectAboveFooter(page) {
+  await expect.poll(async () => {
+    const { panel, footer } = await geometry(page);
+    return panel.bottom - footer.y;
+  }).toBeLessThanOrEqual(0);
+}
+
+for (const [name, path, mode] of [
+  ['English light', '/docs/rail-footer/fixed/', 'light'],
+  ['English dark', '/docs/rail-footer/fixed/', 'dark'],
+  ['Chinese light', '/zh/docs/rail-footer/fixed/', 'light'],
+  ['Chinese dark', '/zh/docs/rail-footer/fixed/', 'dark'],
+  ['without sidebar', '/docs/rail-footer/no-sidebar/', 'light'],
+]) {
+  test(`${name}: wheel and keyboard reach the final taxonomy link above the footer`, async ({ page }) => {
+    await open(page, path, mode);
+    const rail = page.locator(panelSelector);
+    await expect(rail).toHaveCSS('position', 'fixed');
+    const groups = rail.locator('[data-td-shell-tree-toggle]');
+    for (const group of await groups.all()) await expect(group).toHaveAttribute('aria-expanded', 'true');
+    await atBottom(page);
+    await expectAboveFooter(page);
+    const before = await geometry(page);
+    expect(before.aside.scrollHeight).toBeGreaterThan(before.aside.clientHeight);
+
+    await page.mouse.move(before.aside.x + before.aside.width / 2, before.aside.y + 50);
+    await page.mouse.wheel(0, 10000);
+    await expect.poll(async () => (await geometry(page)).aside.scrollTop).toBeGreaterThan(0);
+    await expect.poll(async () => (await geometry(page)).tag.hit).toBe(true);
+    const after = await geometry(page);
+    expect(after.tag.bottom).toBeLessThan(after.footer.y);
+
+    const lastTag = rail.locator(tagSelector).last();
+    const href = await lastTag.getAttribute('href');
+    await lastTag.click();
+    await expect(page).toHaveURL(new RegExp(`${href}$`));
+    await expect(page.locator('main h1')).toBeVisible();
+
+    // Revisit and traverse the actual tab order into the obscured final link.
+    await page.goto(path, { waitUntil: 'networkidle' });
+    await atBottom(page);
+    await rail.locator('[data-td-shell-right-toggle]').focus();
+    for (let i = 0; i < 80 && !(await lastTag.evaluate((el) => el === document.activeElement)); i += 1) {
+      await page.keyboard.press('Tab');
+    }
+    await expect(lastTag).toBeFocused();
+    expect((await geometry(page)).tag.hit).toBe(true);
+    await page.keyboard.press('Enter');
+    await expect(page).toHaveURL(new RegExp(`${href}$`));
+    await expect(page.locator('main h1')).toBeVisible();
+  });
+}
+
+test('rail and fat-footer collapse restore the correct available height', async ({ page }) => {
+  await open(page);
+  await atBottom(page);
+  await expectAboveFooter(page);
+  const expanded = await geometry(page);
+  await page.locator('[data-td-footer-toggle]').click();
+  await expect(page.locator('[data-td-footer-toggle]')).toHaveAttribute('aria-expanded', 'false');
+  await atBottom(page);
+  await expectAboveFooter(page);
+  expect((await geometry(page)).panel.height).toBeGreaterThan(expanded.panel.height);
+  await page.locator('[data-td-footer-toggle]').click();
+  await atBottom(page);
+  await expectAboveFooter(page);
+
+  const hide = page.locator(`${panelSelector} [data-td-shell-right-toggle]`);
+  const restore = page.locator('.td-shell-toc-float [data-td-shell-right-toggle]');
+  await hide.click();
+  await expect(page.locator(panelSelector)).toHaveAttribute('inert', '');
+  await expect(restore).toBeFocused();
+  await restore.click();
+  await expect(hide).toBeFocused();
+  await expectAboveFooter(page);
+});
+
+test('flow stays sticky, no-footer stays full height, and Print hides the rails', async ({ page }) => {
+  await open(page, '/docs/rail-footer/flow/');
+  await atBottom(page);
+  await expect(page.locator(panelSelector)).toHaveCSS('position', 'sticky');
+  await expect(page.locator(panelSelector)).toHaveCSS('inset-block-end', 'auto');
+  await expectAboveFooter(page);
+  await page.goto('/docs/rail-footer/no-footer/', { waitUntil: 'networkidle' });
+  await atBottom(page);
+  await expect(page.locator('[data-td-shell-footer]')).toHaveCount(0);
+  expect((await geometry(page)).panel.bottom).toBe(1000);
+  await page.emulateMedia({ media: 'print' });
+  await expect(page.locator('.td-shell-toc')).toBeHidden();
+  await expect(page.locator('.td-shell-sidebar')).toBeHidden();
+});
+
+test('phone keeps one movable aside in the drawer with usable taxonomy controls', async ({ page }) => {
+  await open(page);
+  await page.setViewportSize({ width: 390, height: 844 });
+  await expect(page.locator(panelSelector)).toBeHidden();
+  await page.locator('[data-td-shell-drawer-open]:visible').click();
+  const aside = page.locator('[data-td-shell-aside-slot] > [data-td-shell-aside]');
+  await expect(aside).toHaveCount(1);
+  const tags = aside.locator('[data-td-taxonomy="tags"]');
+  await tags.locator('[data-td-shell-tree-toggle]').click();
+  await tags.locator('.td-shell-tag').last().scrollIntoViewIfNeeded();
+  await expect(tags.locator('.td-shell-tag').last()).toBeInViewport();
+  await tags.locator('.td-shell-tag').last().click();
+  await expect(page).toHaveURL(/\/tags\/[^/]+\/$/);
+});
diff --git a/tests/browser/table-readability.spec.mjs b/tests/browser/table-readability.spec.mjs
new file mode 100644
index 0000000..925a4c1
--- /dev/null
+++ b/tests/browser/table-readability.spec.mjs
@@ -0,0 +1,137 @@
+import { expect, test } from '@playwright/test';
+
+const nativePath = process.env.TABLE_READABILITY_PATH || '/tests/table-readability/';
+const urlFor = (language) => `${language === 'zh' ? '/zh' : ''}${nativePath}`;
+
+async function geometry(table) {
+  return table.evaluate((node) => {
+    const row = node.tBodies[0].rows[0];
+    const key = row.cells[0];
+    const description = row.cells[row.cells.length - 1];
+    const range = document.createRange();
+    range.selectNodeContents(key);
+    return {
+      keyWidth: key.getBoundingClientRect().width,
+      keyLines: new Set([...range.getClientRects()].map((rect) => Math.round(rect.top))).size,
+      descriptionWidth: description.getBoundingClientRect().width,
+      rowHeight: row.getBoundingClientRect().height,
+      tableWidth: node.getBoundingClientRect().width,
+      viewport: node.parentElement.clientWidth,
+      fontSize: parseFloat(getComputedStyle(description).fontSize),
+    };
+  });
+}
+
+async function expectReadable(page) {
+  const parameters = await geometry(page.locator('#configuration-parameters'));
+  expect(parameters.keyWidth).toBeGreaterThan(150);
+  expect(parameters.keyLines).toBe(1);
+  expect(parameters.rowHeight).toBeLessThan(100);
+
+  const environment = await geometry(page.locator('#environment-variables'));
+  expect(environment.descriptionWidth).toBeGreaterThanOrEqual(280);
+  expect(environment.rowHeight).toBeLessThan(120);
+  expect(environment.fontSize).toBeGreaterThanOrEqual(14);
+  expect(environment.tableWidth).toBeGreaterThan(environment.viewport);
+  expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth + 1)).toBe(true);
+  return environment;
+}
+
+for (const language of ['en', 'zh']) {
+  for (const width of [1440, 768, 390]) {
+    test(`${language} technical columns remain readable at ${width}px`, async ({ page }) => {
+      await page.setViewportSize({ width, height: 1000 });
+      await page.goto(urlFor(language));
+      await page.evaluate(() => document.fonts.ready);
+      const initial = await expectReadable(page);
+      const wrapper = page.locator('#environment-variables').locator('..');
+      await expect(wrapper).toHaveAttribute('tabindex', '0');
+      await expect(wrapper).toHaveAttribute('role', 'region');
+      await wrapper.focus();
+      await wrapper.press('ArrowRight');
+      await expect.poll(() => wrapper.evaluate((node) => node.scrollLeft)).toBeGreaterThan(0);
+      if (width === 1440) {
+        await page.evaluate(() => window.scrollTo({ top: 0, behavior: 'instant' }));
+        await page.locator('[data-td-shell-right-toggle]').first().click();
+        await expect.poll(() => wrapper.evaluate((node) => node.clientWidth)).toBeGreaterThan(initial.viewport);
+        await expectReadable(page);
+      }
+    });
+  }
+}
+
+test('short tables, prose, long tokens, captions, matrix and full-width keep their layout', async ({ page }) => {
+  await page.setViewportSize({ width: 1440, height: 1000 });
+  await page.goto(urlFor('en'));
+  await page.evaluate(() => document.fonts.ready);
+  const short = await geometry(page.locator('#short-example'));
+  expect(Math.abs(short.tableWidth - short.viewport)).toBeLessThan(2);
+  const prose = await geometry(page.locator('#prose-example'));
+  expect(prose.tableWidth).toBeLessThanOrEqual(prose.viewport + 1);
+  expect(prose.rowHeight).toBeGreaterThan(60);
+  expect(prose.rowHeight).toBeLessThan(240);
+
+  const fits = await page.locator('#long-token-example tbody td:first-child').evaluateAll((cells) => cells.map((cell) => {
+    const box = cell.getBoundingClientRect();
+    const row = cell.closest('tr').getBoundingClientRect();
+    const range = document.createRange();
+    range.selectNodeContents(cell);
+    return [...range.getClientRects()].every((rect) => rect.left >= box.left - 1 && rect.right <= box.right + 1 && rect.top >= row.top - 1 && rect.bottom <= row.bottom + 1);
+  }));
+  expect(fits).toEqual([true, true]);
+  await expect(page.locator('#long-token-example caption')).toHaveText('Long identifiers and links');
+  await expect(page.locator('#matrix-example thead th').first()).toHaveCSS('position', 'sticky');
+  await expect(page.locator('#matrix-example tbody th').first()).toHaveCSS('white-space', 'nowrap');
+  const matrixFits = await page.locator('#matrix-example tbody th').first().evaluate((cell) => cell.scrollWidth <= cell.clientWidth + 1);
+  expect(matrixFits).toBe(true);
+  await expect(page.locator('#full-width-example').locator('..')).toHaveClass(/td-table-scroll--full/);
+  await expect(page.locator('#full-width-example caption')).toHaveText('Author-selected full width');
+  const spanning = await page.locator('#spanning-example').evaluate((table) => ({
+    header: table.tHead.rows[0].cells[0].getBoundingClientRect().width,
+    row: table.tBodies[0].rows[0].getBoundingClientRect().width,
+  }));
+  expect(Math.abs(spanning.header - spanning.row)).toBeLessThan(2);
+});
+
+test('native screen tables work across presets and light/dark modes', async ({ page }) => {
+  await page.setViewportSize({ width: 1440, height: 1000 });
+  await page.goto(urlFor('en'));
+  for (const preset of ['slate', 'paper', 'terminal', 'ink']) {
+    for (const mode of ['light', 'dark']) {
+      await page.evaluate(({ preset, mode }) => {
+        document.documentElement.dataset.tdPreset = preset;
+        document.documentElement.dataset.bsTheme = mode;
+      }, { preset, mode });
+      await page.evaluate(() => document.fonts.ready);
+      await expectReadable(page);
+    }
+  }
+});
+
+test('browser Print and dedicated Print keep wrapping and static wrappers', async ({ page }) => {
+  await page.setViewportSize({ width: 1440, height: 1000 });
+  await page.goto(urlFor('en'));
+  await page.emulateMedia({ media: 'print' });
+  await expect(page.locator('#environment-variables td').first()).toHaveCSS('overflow-wrap', 'anywhere');
+  await expect(page.locator('#environment-variables').locator('..')).toHaveCSS('overflow-x', 'visible');
+  const regular = await geometry(page.locator('#environment-variables'));
+  expect(regular.tableWidth).toBeLessThanOrEqual(regular.viewport + 1);
+  await page.emulateMedia({ media: 'screen' });
+  await page.goto(`/_print${nativePath}`);
+  await expect(page.locator('#environment-variables').locator('..')).toHaveClass(/td-table-scroll--static/);
+  await expect(page.locator('#environment-variables').locator('..')).not.toHaveAttribute('tabindex');
+  await expect(page.locator('#environment-variables td').first()).toHaveCSS('overflow-wrap', 'anywhere');
+});
+
+test('technical tables keep readable native geometry without JavaScript', async ({ browser, baseURL }) => {
+  const context = await browser.newContext({ javaScriptEnabled: false, baseURL, viewport: { width: 1440, height: 1000 } });
+  try {
+    const page = await context.newPage();
+    await page.goto(urlFor('en'));
+    // A promise from the page realm need not settle with page scripts disabled.
+    await expect.poll(() => page.evaluate(() => document.fonts.status)).toBe('loaded');
+    await expectReadable(page);
+  } finally {
+    await context.close();
+  }
+});
