new file mode 100644
--- /dev/null
+++ b/tests/browser/table-layout-policy.spec.mjs
@@ -0,0 +1,87 @@
+import { expect, test } from '@playwright/test';
+
+const urlFor = (language) => `${language === 'zh' ? '/zh' : ''}/tests/table-layout-policy/`;
+
+async function measure(table) {
+  return table.evaluate((node) => {
+    const viewport = node.parentElement;
+    const cells = [...node.tBodies[0].rows[0].cells];
+    return {
+      width: node.getBoundingClientRect().width,
+      available: viewport.clientWidth,
+      scrollWidth: viewport.scrollWidth,
+      description: cells.at(-1).getBoundingClientRect().width,
+      rowHeight: node.tBodies[0].rows[0].getBoundingClientRect().height,
+      lines: cells.map((cell) => {
+        const range = document.createRange();
+        range.selectNodeContents(cell);
+        return new Set([...range.getClientRects()].map((rect) => Math.round(rect.top))).size;
+      }),
+    };
+  });
+}
+
+for (const language of ['en', 'zh']) {
+  for (const width of [1440, 390]) {
+    test(`${language}: ordinary prose and explicit technical width at ${width}px`, async ({ page }) => {
+      await page.setViewportSize({ width, height: 1000 });
+      await page.goto(urlFor(language));
+      await page.evaluate(() => document.fonts.ready);
+      const prose = page.locator('#ordinary-prose-table');
+      const technical = page.locator('#wide-technical-table');
+      await expect(prose).not.toHaveClass(/td-table--wide/);
+      await expect(technical).toHaveClass(/td-table--wide/);
+      const wide = await measure(technical);
+      expect(wide.description).toBeGreaterThanOrEqual(280);
+      expect(wide.rowHeight).toBeLessThan(120);
+      const wrapper = technical.locator('..');
+      await expect(wrapper).toHaveAttribute('tabindex', '0');
+      await wrapper.focus();
+      await wrapper.press('ArrowRight');
+      await expect.poll(() => wrapper.evaluate((node) => node.scrollLeft)).toBeGreaterThan(0);
+      expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth + 1)).toBe(true);
+      if (width === 1440) {
+        const before = await measure(prose);
+        expect(before.scrollWidth).toBeLessThanOrEqual(before.available + 1);
+        expect(Math.max(...before.lines)).toBeGreaterThan(1);
+        await page.evaluate(() => window.scrollTo({ top: 0, behavior: 'instant' }));
+        await page.locator('[data-td-shell-right-toggle]:visible').first().click();
+        await expect.poll(async () => (await measure(prose)).available).toBeGreaterThan(before.available);
+        const after = await measure(prose);
+        expect(after.scrollWidth).toBeLessThanOrEqual(after.available + 1);
+        expect((await measure(technical)).description).toBeGreaterThanOrEqual(280);
+      }
+    });
+  }
+}
+
+test('wide is independent of matrix, full-width and static output', async ({ page }) => {
+  await page.setViewportSize({ width: 1440, height: 1000 });
+  await page.goto(urlFor('en'));
+  const matrix = page.locator('#wide-matrix-table');
+  await expect(matrix).toHaveClass(/td-table--wide/);
+  await expect(matrix).toHaveClass(/td-table--matrix/);
+  await expect(matrix.locator('..')).toHaveClass(/td-table-scroll--full/);
+  await expect(matrix.locator('tbody th').first()).toHaveCSS('white-space', 'nowrap');
+  await page.emulateMedia({ media: 'print' });
+  await expect(page.locator('#wide-technical-table td').first()).toHaveCSS('overflow-wrap', 'anywhere');
+  await page.emulateMedia({ media: 'screen' });
+  await page.goto('/_print/tests/table-layout-policy/');
+  await expect(page.locator('#wide-technical-table').locator('..')).toHaveClass(/td-table-scroll--static/);
+  await expect(page.locator('#wide-technical-table td').first()).toHaveCSS('overflow-wrap', 'anywhere');
+});
+
+test('explicit technical width works without page JavaScript', async ({ browser, baseURL }) => {
+  const context = await browser.newContext({ javaScriptEnabled: false, baseURL, viewport: { width: 1440, height: 1000 } });
+  try {
+    const page = await context.newPage();
+    await page.goto(urlFor('en'));
+    await expect.poll(() => page.evaluate(() => document.fonts.status)).toBe('loaded');
+    const wide = await measure(page.locator('#wide-technical-table'));
+    expect(wide.description).toBeGreaterThanOrEqual(280);
+    const prose = await measure(page.locator('#ordinary-prose-table'));
+    expect(prose.scrollWidth).toBeLessThanOrEqual(prose.available + 1);
+  } finally {
+    await context.close();
+  }
+});
