diff --git a/tests/browser/rail-footer.spec.mjs b/tests/browser/rail-footer.spec.mjs
new file mode 100644
index 0000000..d6c45c9
--- /dev/null
+++ b/tests/browser/rail-footer.spec.mjs
@@ -0,0 +1,164 @@
+import { expect, test } from '@playwright/test';
+
+const panelSelector = '.td-shell-toc__panel';
+const asideSelector = `${panelSelector} > [data-td-shell-aside]`;
+const tagSelector = '[data-td-taxonomy="tags"] .td-shell-tag';
+
+async function open(page, path = '/docs/rail-footer/fixed/', mode = 'light') {
+  await page.setViewportSize({ width: 1440, height: 1000 });
+  await page.addInitScript((mode) => {
+    localStorage.clear();
+    localStorage.setItem('td-color-theme', mode);
+    localStorage.setItem('td-preset', 'slate');
+  }, mode);
+  await page.goto(path, { waitUntil: 'networkidle' });
+  await page.evaluate(() => document.fonts.ready);
+  await expect(page.locator('html')).toHaveAttribute('data-bs-theme', mode);
+  await expect(page.locator('html')).toHaveAttribute('data-td-shell-initialized', '');
+}
+
+async function atBottom(page) {
+  // Use real wheel input over the article. A disclosure resize can change
+  // the document height after a wheel event, so keep scrolling until settled.
+  await page.mouse.move(700, 200);
+  await expect(async () => {
+    await page.mouse.wheel(0, 20000);
+    await expect.poll(() => page.evaluate(() =>
+      Math.abs(scrollY + innerHeight - document.documentElement.scrollHeight),
+    ), { timeout: 1000 }).toBeLessThanOrEqual(2);
+  }).toPass({ timeout: 5000 });
+}
+
+async function geometry(page) {
+  return page.evaluate(({ panelSelector, asideSelector, tagSelector }) => {
+    const panel = document.querySelector(panelSelector);
+    const aside = document.querySelector(asideSelector);
+    const footer = document.querySelector('[data-td-shell-footer]');
+    const tags = panel.querySelectorAll(tagSelector);
+    const tag = tags[tags.length - 1];
+    const bounds = (element) => {
+      const r = element.getBoundingClientRect();
+      return { x: r.x, y: r.y, width: r.width, height: r.height, bottom: r.bottom };
+    };
+    const r = tag?.getBoundingClientRect();
+    const point = r && document.elementFromPoint(r.x + r.width / 2, r.y + r.height / 2);
+    return {
+      panel: bounds(panel),
+      footer: footer && bounds(footer),
+      aside: aside && {
+        ...bounds(aside), scrollHeight: aside.scrollHeight,
+        clientHeight: aside.clientHeight, scrollTop: aside.scrollTop,
+      },
+      tag: tag && { ...bounds(tag), hit: tag === point || tag.contains(point) },
+      position: getComputedStyle(panel).position,
+      inset: getComputedStyle(panel).insetBlockEnd,
+    };
+  }, { panelSelector, asideSelector, tagSelector });
+}
+
+async function expectAboveFooter(page) {
+  await expect.poll(async () => {
+    const { panel, footer } = await geometry(page);
+    return panel.bottom - footer.y;
+  }).toBeLessThanOrEqual(0);
+}
+
+for (const [name, path, mode] of [
+  ['English light', '/docs/rail-footer/fixed/', 'light'],
+  ['English dark', '/docs/rail-footer/fixed/', 'dark'],
+  ['Chinese light', '/zh/docs/rail-footer/fixed/', 'light'],
+  ['Chinese dark', '/zh/docs/rail-footer/fixed/', 'dark'],
+  ['without sidebar', '/docs/rail-footer/no-sidebar/', 'light'],
+]) {
+  test(`${name}: wheel and keyboard reach the final taxonomy link above the footer`, async ({ page }) => {
+    await open(page, path, mode);
+    const rail = page.locator(panelSelector);
+    await expect(rail).toHaveCSS('position', 'fixed');
+    const groups = rail.locator('[data-td-shell-tree-toggle]');
+    for (const group of await groups.all()) await expect(group).toHaveAttribute('aria-expanded', 'true');
+    await atBottom(page);
+    await expectAboveFooter(page);
+    const before = await geometry(page);
+    expect(before.aside.scrollHeight).toBeGreaterThan(before.aside.clientHeight);
+
+    await page.mouse.move(before.aside.x + before.aside.width / 2, before.aside.y + 50);
+    await page.mouse.wheel(0, 10000);
+    await expect.poll(async () => (await geometry(page)).aside.scrollTop).toBeGreaterThan(0);
+    await expect.poll(async () => (await geometry(page)).tag.hit).toBe(true);
+    const after = await geometry(page);
+    expect(after.tag.bottom).toBeLessThan(after.footer.y);
+
+    const lastTag = rail.locator(tagSelector).last();
+    const href = await lastTag.getAttribute('href');
+    await lastTag.click();
+    await expect(page).toHaveURL(new RegExp(`${href}$`));
+    await expect(page.locator('main h1')).toBeVisible();
+
+    // Revisit and traverse the actual tab order into the obscured final link.
+    await page.goto(path, { waitUntil: 'networkidle' });
+    await atBottom(page);
+    await rail.locator('[data-td-shell-right-toggle]').focus();
+    for (let i = 0; i < 80 && !(await lastTag.evaluate((el) => el === document.activeElement)); i += 1) {
+      await page.keyboard.press('Tab');
+    }
+    await expect(lastTag).toBeFocused();
+    expect((await geometry(page)).tag.hit).toBe(true);
+    await page.keyboard.press('Enter');
+    await expect(page).toHaveURL(new RegExp(`${href}$`));
+    await expect(page.locator('main h1')).toBeVisible();
+  });
+}
+
+test('rail and fat-footer collapse restore the correct available height', async ({ page }) => {
+  await open(page);
+  await atBottom(page);
+  await expectAboveFooter(page);
+  const expanded = await geometry(page);
+  await page.locator('[data-td-footer-toggle]').click();
+  await expect(page.locator('[data-td-footer-toggle]')).toHaveAttribute('aria-expanded', 'false');
+  await atBottom(page);
+  await expectAboveFooter(page);
+  expect((await geometry(page)).panel.height).toBeGreaterThan(expanded.panel.height);
+  await page.locator('[data-td-footer-toggle]').click();
+  await atBottom(page);
+  await expectAboveFooter(page);
+
+  const hide = page.locator(`${panelSelector} [data-td-shell-right-toggle]`);
+  const restore = page.locator('.td-shell-toc-float [data-td-shell-right-toggle]');
+  await hide.click();
+  await expect(page.locator(panelSelector)).toHaveAttribute('inert', '');
+  await expect(restore).toBeFocused();
+  await restore.click();
+  await expect(hide).toBeFocused();
+  await expectAboveFooter(page);
+});
+
+test('flow stays sticky, no-footer stays full height, and Print hides the rails', async ({ page }) => {
+  await open(page, '/docs/rail-footer/flow/');
+  await atBottom(page);
+  await expect(page.locator(panelSelector)).toHaveCSS('position', 'sticky');
+  await expect(page.locator(panelSelector)).toHaveCSS('inset-block-end', 'auto');
+  await expectAboveFooter(page);
+  await page.goto('/docs/rail-footer/no-footer/', { waitUntil: 'networkidle' });
+  await atBottom(page);
+  await expect(page.locator('[data-td-shell-footer]')).toHaveCount(0);
+  expect((await geometry(page)).panel.bottom).toBe(1000);
+  await page.emulateMedia({ media: 'print' });
+  await expect(page.locator('.td-shell-toc')).toBeHidden();
+  await expect(page.locator('.td-shell-sidebar')).toBeHidden();
+});
+
+test('phone keeps one movable aside in the drawer with usable taxonomy controls', async ({ page }) => {
+  await open(page);
+  await page.setViewportSize({ width: 390, height: 844 });
+  await expect(page.locator(panelSelector)).toBeHidden();
+  await page.locator('[data-td-shell-drawer-open]:visible').click();
+  const aside = page.locator('[data-td-shell-aside-slot] > [data-td-shell-aside]');
+  await expect(aside).toHaveCount(1);
+  const tags = aside.locator('[data-td-taxonomy="tags"]');
+  await tags.locator('[data-td-shell-tree-toggle]').click();
+  await tags.locator('.td-shell-tag').last().scrollIntoViewIfNeeded();
+  await expect(tags.locator('.td-shell-tag').last()).toBeInViewport();
+  await tags.locator('.td-shell-tag').last().click();
+  await expect(page).toHaveURL(/\/tags\/[^/]+\/$/);
+});
